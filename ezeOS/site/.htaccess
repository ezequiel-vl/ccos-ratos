# ezeOS: site institucional (Hostinger)
# HTTPS: ative em hPanel > Seguranca > SSL > Forcar HTTPS, depois que o certificado estiver ativo.

Options -Indexes
DirectoryIndex index.html

# www vira o endereco oficial, sem www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.ezeos\.com\.br$ [NC]
RewriteRule ^(.*)$ https://ezeos.com.br/$1 [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>
